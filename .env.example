# Copy this file to .env and fill in your keys

# === LLM Providers (fill in at least one) ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# === Optional LLM Providers ===
DEEPSEEK_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# === Data Vendors (optional — yfinance + MFApi are free/keyless) ===
ALPHA_VANTAGE_API_KEY=
NEWSAPI_KEY=
FINNHUB_KEY=

# === App Overrides (optional) ===
